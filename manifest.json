{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "2.3.0",
  "key": "",
  "description": "__MSG_appDesc__",
  "homepage_url": "https://github.com/ahlanbrito/AiResponses-front",
  "permissions": [
    "storage",
    "identity",
    "contextMenus",
    "activeTab"
  ],
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "__MSG_captureAndAnalyze__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "host_permissions": [
    "https://apipreguntasai.runasp.net/*",
    "<all_urls>"
  ],
  "oauth2": {
    "client_id": "968276521957-r5sacm17ubj6u8q81beefmbj8uc81jid.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [{
    "resources": ["popup.html", "popup.js", "styles.css", "lucide.min.js", "i18n.js"],
    "matches": ["<all_urls>"]
  }],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  }
}
